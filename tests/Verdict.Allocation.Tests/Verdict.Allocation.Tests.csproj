<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- The contention gate counts collections, and the thresholds it asserts
         were measured under server GC. Workstation GC collects on a different
         schedule, so the setting is part of the test rather than the machine. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xUnit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Verdict/Verdict.csproj" />
    <ProjectReference Include="../../src/Verdict.Fluent/Verdict.Fluent.csproj" />
    <ProjectReference Include="../../src/Verdict.Extensions/Verdict.Extensions.csproj" />
    <ProjectReference Include="../../src/Verdict.Async/Verdict.Async.csproj" />
    <ProjectReference Include="../../src/Verdict.Rich/Verdict.Rich.csproj" />
    <ProjectReference Include="../../src/Verdict.Json/Verdict.Json.csproj" />
  </ItemGroup>
</Project>
