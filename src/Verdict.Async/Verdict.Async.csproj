<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    
    <!-- Package Metadata -->
    <PackageId>Verdict.Async</PackageId>
    <Description>Baryo.Dev: Async/await extensions for Verdict. Fluent async operations for Result types.</Description>
    <PackageTags>result;async;await;task</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Verdict\Verdict.csproj" />
  </ItemGroup>

  <!-- ValueTask is in the box from net8.0 onwards. On netstandard2.0 it needs
       this, the same way Verdict.Extensions needs System.Memory for ArrayPool.
       Microsoft-owned and tiny, and the alternative is a ValueTask API that
       exists on one target and not the other. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>

</Project>
