<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    
    <!-- Package Metadata -->
    <PackageId>Verdict.Rich</PackageId>
    <Description>Baryo.Dev: Rich metadata extensions for Verdict. Success messages, error metadata, global factories, and custom error types with minimal performance overhead.</Description>
    <PackageTags>result;metadata;audit;enterprise;rich</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Verdict\Verdict.csproj" />
  </ItemGroup>


  <!-- Backfills a BCL type that netstandard2.0 lacks; net8.0 has it in-box. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Collections.Immutable" Version="10.0.1" />
  </ItemGroup>

</Project>
